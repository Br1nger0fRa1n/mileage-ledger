# --- Server ---
# Railway sets PORT automatically. Locally, defaults to 3000.
PORT=3000
# Your public Railway URL once deployed, e.g. https://yourapp-production.up.railway.app
# Used to build Strava/Plaid callback + webhook URLs. No trailing slash.
PUBLIC_URL=http://localhost:3000

# --- Database ---
# Railway injects this automatically when you attach a Postgres service.
# Locally, point it at your own Postgres instance.
DATABASE_URL=postgres://user:password@localhost:5432/mileage_ledger

# --- Strava ---
# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Random string you make up yourself, used to verify webhook subscription requests
STRAVA_VERIFY_TOKEN=change-this-to-a-random-string

# --- Plaid ---
# From https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
# 'sandbox' while testing with fake banks, 'production' once using your real bank
PLAID_ENV=sandbox

# --- Password lock ---
# The password you'll type to unlock the dashboard on your phone/browser.
APP_PASSWORD=change-this-to-something-only-you-know
# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-string

# --- Mileage rates ($ per mile), tune these anytime ---
RATE_RUN=1.00
RATE_BIKE=0.30
RATE_SWIM=3.00
RATE_HIKE=1.00
